# Copy to demo.env (untracked) on the demo VM. No secrets live here: the only secret,
# the visitor key, is minted by seed.sh into out/ and rotated by every reset.
DEMO_DOMAIN=demo.example.com
ACME_EMAIL=ops@example.com
# Visitor key lifetime in days (a nightly reset replaces it sooner).
DEMO_KEY_DAYS=2
# Per-key request budget for the shared visitor key.
DEMO_RATE_PER_MINUTE=60
